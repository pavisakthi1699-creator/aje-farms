# GEMINI_API: Required for Gemini AI API calls. Use this exact name in Railway.
# GEMINI_API_KEY is read only as a backwards-compatible fallback.
GEMINI_API="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Release preflight expects NODE_ENV=production for deployed backend checks.
NODE_ENV="development"

# Supabase Auth verifies every session token (see server/auth.js). Required
# even when AJE_STORE=json/postgres, since auth verification is independent
# of which backend holds application data.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Client-safe key embedded in the Flutter release; never use the service role key.
SUPABASE_PUBLISHABLE_KEY=""

# Gates the dev-only POST /api/auth/dev-session bypass (see server/api.js),
# which issues a session without a real Supabase Auth token. Keep false
# (default). Release preflight blocks "true". NODE_ENV=development already
# enables the same bypass, independent of this flag.
AJE_ENABLE_DEBUG_OTP="false"

# Required for the local development payment webhook.
AJE_DEV_PAYMENT_WEBHOOK_SECRET=""
AJE_ENABLE_LEGACY_DEV_PAYMENTS="false"

# Backend persistence. Use "json" for local file storage (default), "postgres"
# for DATABASE_URL-backed storage, or "supabase" for a dedicated Supabase DB.
AJE_STORE="json"
DATABASE_URL=""
SUPABASE_DATABASE_URL=""
# Editor JWT used by NotebookLM import/promotion scripts:
# npm run import:notebooklm -- --file imports/rice-seed-video-course/rice_seed_video_course.csv
AJE_EDITOR_JWT=""
# Optional. Dedicated Supabase projects can use public. Set to "aje" only if
# sharing a database with other products.
AJE_DB_SCHEMA="public"

# Optional overrides for JSON-backed persistence.
AJE_DATA_FILE=""
AJE_COMMUNITY_DATA_FILE=""

# Optional comma-separated admin email allowlist for bootstrapping admin
# access before a full staff role-management UI exists.
AJE_ADMIN_EMAILS=""

# Push provider. Use "development" locally, or "fcm" for Firebase Cloud
# Messaging in production.
AJE_PUSH_PROVIDER="development"
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
# Use escaped newlines if storing in a single-line environment variable.
FCM_PRIVATE_KEY=""
# Alternative to the three FCM_* vars above: full Firebase service account JSON.
FCM_SERVICE_ACCOUNT_JSON=""

# Android release build config:
# AJE_ANDROID_API_BASE_URL is used by npm run preflight:release to verify the
# API URL you plan to pass to Flutter.
AJE_ANDROID_API_BASE_URL=""
AJE_WHATSAPP_EXPERT_PHONE=""
# Public pages served by the production API and shown inside the app/Play listing.
AJE_PRIVACY_POLICY_URL=""
AJE_ACCOUNT_DELETION_URL=""
AJE_PRIVACY_CONTACT_EMAIL=""
# Comma-separated SHA-256 fingerprints from Play Console > App integrity.
# The backend publishes these at /.well-known/assetlinks.json.
AJE_ANDROID_APP_SIGNING_SHA256=""
# Google Play release policy: this app consumes access assigned elsewhere and
# contains no learner purchase or external-payment steering flow.
AJE_PLAY_DISTRIBUTION_MODE="consumption_only"
# flutter build apk --release \
#   --dart-define=AJE_API_BASE_URL="https://api.your-domain.example" \
#   --dart-define=AJE_WHATSAPP_EXPERT_PHONE="$AJE_WHATSAPP_EXPERT_PHONE"

# Local Postgres smoke (docker compose):
# DATABASE_URL="postgresql://aje:aje@localhost:5432/aje_farms"
# npm run smoke:postgres

# Dedicated Supabase smoke:
# AJE_STORE=supabase
# SUPABASE_DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"
# npm run dev:supabase
# npm run smoke:supabase
# npm run smoke:supabase:live  # non-destructive schema/RLS/readiness check

# Connected mobile smoke against a running backend:
# cd aje_farms_mobile
# flutter test integration_test/connected_app_smoke_test.dart \
#   --dart-define=AJE_API_BASE_URL=http://127.0.0.1:3000
