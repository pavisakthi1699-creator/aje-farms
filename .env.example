# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Release preflight expects NODE_ENV=production for deployed backend checks.
NODE_ENV="development"

# Optional: real SMS OTP delivery. If all three are set, the backend sends OTPs
# through Twilio. Without them, local development logs OTPs to the server console.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional: return debugOtp in local API responses. Never enable in production.
AJE_ENABLE_DEBUG_OTP="true"

# Required for the local development payment webhook.
AJE_DEV_PAYMENT_WEBHOOK_SECRET=""

# Backend persistence. Use "json" for local file storage (default) or
# "postgres" for DATABASE_URL-backed users, OTP, and payments.
AJE_STORE="json"
DATABASE_URL=""

# Optional overrides for JSON-backed persistence.
AJE_DATA_FILE=""
AJE_COMMUNITY_DATA_FILE=""

# Optional comma-separated admin phone allowlist for bootstrapping moderation
# access before a full admin user-management UI exists.
AJE_ADMIN_PHONE_NUMBERS=""

# Push provider is not wired yet. The backend stores notification inbox/device
# registrations and logs notification dispatches in development.
AJE_PUSH_PROVIDER="development"

# Android release build config:
# AJE_ANDROID_API_BASE_URL is used by npm run preflight:release to verify the
# API URL you plan to pass to Flutter.
AJE_ANDROID_API_BASE_URL=""
AJE_WHATSAPP_EXPERT_PHONE=""
# flutter build apk --release \
#   --dart-define=AJE_API_BASE_URL="https://api.example.com" \
#   --dart-define=AJE_WHATSAPP_EXPERT_PHONE="$AJE_WHATSAPP_EXPERT_PHONE"

# Required in production when AJE_STORE=postgres or for OTP hashing. Use a
# unique secret with at least 32 characters.
AJE_OTP_PEPPER=""

# Local Postgres smoke (docker compose):
# DATABASE_URL="postgresql://aje:aje@localhost:5432/aje_farms"
# npm run smoke:postgres
